# Copy to .env (start.bat reads it). Never commit .env.
# Everything works with this file empty: simulation, decision room, evidence, validation and the deterministic Tribunal.

# ---- AI agent backend: OFF unless you name one here --------------------------------------------
# off        default. No model, no network. The Tribunal shows the deterministic local analysis.
# ollama     a model already installed in Ollama on THIS machine (free, local). Nothing is downloaded for you.
# claude_cli the Claude Code CLI on this machine; billed to the logged-in Claude account.
# anthropic  the paid Anthropic API; needs ANTHROPIC_API_KEY.
# An API key or an installed CLI never switches a backend on by itself.
CASCADE_LLM=off

# ollama only: a model you have already pulled (ollama pull <name>), and the local server address (must be localhost).
CASCADE_OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
CASCADE_OLLAMA_CTX=32768

# anthropic / claude_cli only.
ANTHROPIC_API_KEY=
CASCADE_MODEL=claude-opus-5-5

# ---- Server ------------------------------------------------------------------------------------
# Port used by start.bat / stop.bat.
CASCADE_PORT=8000
# Run history database. Empty = SQLite file cascade.db in the project folder.
# PostgreSQL: pip install psycopg, then postgresql+psycopg://user:password@host:5432/cascade
DATABASE_URL=
# Only when the interface is hosted on another origin (e.g. a Vercel URL). Comma-separated. Empty = same origin only.
CASCADE_CORS_ORIGINS=
